{
  "name": "kritam",
  "version": "0.1.0",
  "private": true,
  "description": "A privacy-first personal desktop AI companion.",
  "main": "desktop/main.js",
  "author": "Deepanshu779",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.kritam.desktop",
    "productName": "KRITAM",
    "asar": true,
    "files": [
      "desktop/**/*",
      "core/**/*",
      "assets/**/*",
      "index.html",
      "styles.css",
      "app.js",
      "voice-controller.js",
      "conversation-ui.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "KRITAM-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KRITAM"
    }
  }
}
